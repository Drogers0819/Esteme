# ---------------------------------------------------------------------------
# Esteme Consulting — environment variables
# Copy this file to `.env.local` and fill in real values before launch.
# ---------------------------------------------------------------------------

# Where the contact form submissions are forwarded.
# The /api/contact route POSTs the JSON payload to this URL.
# Swap in a Formspree endpoint, a Resend-backed handler, or a CRM webhook.
# Examples:
#   https://formspree.io/f/xxxxxxxx
#   https://hooks.zapier.com/hooks/catch/xxxxxx/xxxxxx/
# If left blank, the API route logs submissions to the server console only
# (useful in local development).
CONTACT_FORM_ENDPOINT=

# Public site URL — used for canonical links, sitemap and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://estemeconsulting.com

# Calendar booking embed URL (Cal.com or Calendly).
# Shown on the /contact page. Leave blank to display the placeholder note.
# Example: https://cal.com/esteme/intro
NEXT_PUBLIC_CALENDAR_URL=

# Contact email shown in the footer and on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@estemeconsulting.com

# Analytics placeholder (e.g. Plausible / GA4 measurement ID).
# Not wired to any provider by default — add your snippet in app/layout.tsx.
NEXT_PUBLIC_ANALYTICS_ID=
